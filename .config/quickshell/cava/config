[general]
bars = 25
framerate = 60

; Without this, cava's default (stereo) splits `bars` across left/right
; channels - 25 doesn't divide evenly in two, so the raw output's actual
; field count per line never matched what Cava.qml expected, and every
; frame got silently dropped by its strict length check. Mono means one
; set of `bars` values per line, matching that check exactly.
channels = mono

[input]
method = pulse
source = auto

[output]
method = raw
raw_target = /dev/stdout
data_format = ascii
ascii_max_range = 100
bar_delimiter = 59
frame_delimiter = 10
