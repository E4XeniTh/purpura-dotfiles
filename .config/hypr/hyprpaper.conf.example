wallpaper {
    monitor = DP-1
    path = ~/.config/hypr/wallpapers/particles.png
    fit_mode = cover
}

wallpaper {
    monitor = eDP-1
    path = ~/.config/hypr/wallpapers/particles.png
    fit_mode = cover
}

wallpaper {
    monitor = HDMI-1
    path = ~/.config/hypr/wallpapers/particles.png
    fit_mode = cover
}

wallpaper {
    monitor = HDMI-A-1
    path = ~/.config/hypr/wallpapers/particles.png
    fit_mode = cover
}
    splash = false
